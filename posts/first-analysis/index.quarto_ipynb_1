        "import pandas as pd\n",
        "\n",
        "data = {\"Month\": [\"Jan\",\"Feb\",\"Mar\",\"Apr\"], \n",
        "        \"Value\": [120, 145, 133, 160]}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "ax.bar(df[\"Month\"], df[\"Value\"], color=\"#2563eb\")\n",
        "ax.set_title(\"My First Chart\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
